# Runtime
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Node
node_modules/
remotion/node_modules/
remotion/out/
out/

# Vídeo de origem estagiado para o Remotion (nunca commitar)
remotion/public/*
!remotion/public/.gitkeep

# Jobs e artefatos gerados
workspace/jobs/*/
!workspace/jobs/.gitkeep

# Assets (áudio/vídeo pesados não vão pro git)
assets/sound_effects/*
!assets/sound_effects/.gitkeep
assets/nocopyright_music/*
!assets/nocopyright_music/.gitkeep
assets/source_videos/*
!assets/source_videos/.gitkeep
assets/broll/*
!assets/broll/.gitkeep

# Mídia
*.mp4
*.mkv
*.mov
*.wav
*.mp3
*.m4a

# Fixtures de vídeo: geradas sob demanda por tests/fixtures/make_fixtures.py
tests/fixtures/*.mp4
tests/fixtures/*.wav
# ...mas o script gerador e o gabarito JSON são versionados
!tests/fixtures/*.py

# Cache de etapas e relatórios de eval (gerados, não versionados)
.eval_cache/
eval/reports/

# Modelos locais pesados
# Exceção: assets/models/ é versionado — blaze_face_short_range.tflite (~224 KB)
# é necessário para o MediaPipe FaceDetector funcionar. Sem ele, backend=none.
/models/
*.onnx
*.bin
*.safetensors
!assets/models/*.tflite

# Sistema
.DS_Store
*.log
.env

# Cache de decisão (Jev/heurística)
.decision_cache/

# B-roll baixado (cache) e acervo local do operador
.broll_cache/
